# qpubench credentials — copy to .env and fill in.
#
# .env is gitignored. Nothing here is ever passed to qpubench as a literal
# argument: adapters take a *_ref parameter naming the variable to read, and
# only that name is stored in a BackendSpec / BenchmarkRecord. Never hardcode a
# token, password or key in source, notebooks, or examples.
#
# The variable names below are the defaults each adapter looks for; point an
# adapter at a different one with e.g. IBMAdapter(..., token_ref="MY_VAR").

# ── IBM Quantum ───────────────────────────────────────────────────────────────
# qiskit-ibm-runtime requires channel "ibm_quantum_platform" (the old
# "ibm_quantum" value is rejected since qiskit-ibm-runtime 0.40).
IBM_QUANTUM_TOKEN="YOUR_TOKEN"
IBM_QUANTUM_CHANNEL="ibm_quantum_platform"
# Account-specific — hub/group/project, or a Cloud Resource Name (CRN) on the
# newer channel. No built-in default: IBMAdapter raises if neither this nor an
# explicit instance= argument is set.
IBM_QUANTUM_INSTANCE="ibm-q/open/main"

# ── IQM Resonance ─────────────────────────────────────────────────────────────
IQM_TOKEN="YOUR_TOKEN"
IQM_SERVER_URL="https://cocos.resonance.meetiqm.com/v1"

# ── Quantinuum H-Series ───────────────────────────────────────────────────────
# pytket-quantinuum authenticates via the Quantinuum Nexus credential store;
# run QuantinuumBackend.login() (or qnexus.login()) once to cache a token.
# QUANTINUUM_USER names the account email for non-interactive login
# (BackendSpec.quantinuum(user_ref="QUANTINUUM_USER")).
QUANTINUUM_USER="your@email.com"

# ── Qibo ──────────────────────────────────────────────────────────────────────
# The local simulator (execution="local") needs no credentials. For the cloud
# path (qibo-cloud-backends): QIBO_CLIENT_TOKEN for the TII qibo-client,
# IBMQ_TOKEN for the qiskit-client (IBM servers). Name the env var via
# BackendSpec.qibo_cloud(token_ref=...).
QIBO_CLIENT_TOKEN="YOUR_TOKEN"

# ── AWS (Braket adapter, S3Store) ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID="YOUR_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_SECRET"
# Required by S3Store — there is no built-in region default. The Hugging Face
# S3 gateway is single-region and expects us-east-1.
AWS_REGION="us-east-1"
BRAKET_S3_BUCKET="amazon-braket-your-bucket"

# ── Cebule (MQS SDK) ──────────────────────────────────────────────────────────
# Used by mqsdk.Cebule(EMAIL, PASSWORD).
EMAIL="your@email.com"
PASSWORD="your_password"

# ── Qrack ─────────────────────────────────────────────────────────────────────
# GPU selection; -1 = auto-detect.
QRACK_DEVICE_ID="-1"
# QRACK_FPPOW=6 for double precision; 5 for float (default).
QRACK_FPPOW="6"

# ── MBQC-FPGA ─────────────────────────────────────────────────────────────────
# Path to compiled bitstream or simulator binary.
MBQC_BITSTREAM_PATH="/path/to/bitstream.bit"
